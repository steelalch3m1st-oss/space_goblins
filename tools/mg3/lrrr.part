.ringE{fill:none;stroke:#35e0ff;stroke-width:5;animation:rg 1.1s steps(2,end) infinite}
.ringE.hit{animation:none;stroke-width:8}
@keyframes rg{50%{stroke-width:8;opacity:.65}}
.bar{height:14px;border:2px solid #fff;position:relative;width:200px;background:#000}
.bar i{display:block;height:100%;background:#fff;width:0}
.bar b{position:absolute;top:-4px;bottom:-4px;left:85%;border-left:2px solid #35e0ff}
.bar.ok i{background:#35e0ff}
.al{display:flex;align-items:center;gap:10px;font-size:10px}
.al span.n{min-width:56px;text-align:right}
.pips{display:flex;gap:6px;align-items:center;font-size:8px;color:#9a9a9a}
.pips u{margin-right:6px;display:inline-block;width:14px;height:14px;border:2px solid #fff;background:#fff;text-decoration:none}
.pips u.x{background:#000;border-color:#555}
.pad.big{grid-template-columns:repeat(3,56px);grid-auto-rows:56px}
.send{padding:14px 18px}
@@BODY@@
<main class="g">
<h1 class="title">LRRR REFLECTOR</h1>
<p class="lead">MOON · APOLLO 11 · LASER RANGING RETROREFLECTOR</p>
<div class="stage"><svg id="sv" viewBox="0 0 800 420" aria-label="Lunar surface with a reflector on a tripod, Earth in the sky and a cyan alignment ring">
<defs>
 <pattern id="dth" width="4" height="4" patternUnits="userSpaceOnUse"><rect width="2" height="2" fill="#4a4a4a"/><rect x="2" y="2" width="2" height="2" fill="#4a4a4a"/></pattern>
 <pattern id="dt2" width="3" height="3" patternUnits="userSpaceOnUse"><rect width="1" height="1" fill="#2a2a2a"/></pattern>
 <clipPath id="eclip"><circle cx="0" cy="0" r="46"/></clipPath>
</defs>
<rect width="800" height="420" fill="#000"/>
<g fill="#fff"><rect x="60" y="40" width="2" height="2"/><rect x="190" y="90" width="2" height="2"/><rect x="330" y="30" width="2" height="2"/><rect x="420" y="170" width="2" height="2"/><rect x="700" y="60" width="3" height="3"/><rect x="760" y="200" width="2" height="2"/><rect x="120" y="190" width="2" height="2"/><rect x="480" y="60" width="2" height="2"/><rect x="620" y="250" width="2" height="2"/><rect x="260" y="230" width="2" height="2"/></g>
<!-- Earth + target ring -->
<g id="earth">
 <circle id="ringE" class="ringE" cx="0" cy="0" r="78"/>
 <circle cx="0" cy="0" r="46" fill="#0b0b0b" stroke="#fff" stroke-width="2"/>
 <g clip-path="url(#eclip)"><circle cx="0" cy="0" r="46" fill="url(#dth)" opacity=".5"/>
  <path d="M-34 -14Q-22 -28 -6 -22T6 -8Q-4 6 -14 4T-34 -14Z" fill="#666" stroke="#aaa"/>
  <path d="M10 6Q26 -4 36 8T26 30Q14 34 8 22Z" fill="#666" stroke="#aaa"/>
  <path d="M-30 22H-6M4 -30H30M-12 34H14" stroke="#fff" stroke-width="3" stroke-dasharray="10 8" opacity=".8"/></g>
 <text x="0" y="-92" text-anchor="middle" font-size="9" fill="#35e0ff">MOVE SIGHT HERE</text>
</g>
<!-- lunar surface -->
<path d="M0 372Q110 352 250 366T520 362T800 368V420H0Z" fill="#1a1a1a" stroke="#fff" stroke-width="2"/>
<path d="M0 372Q110 352 250 366T520 362T800 368V420H0Z" fill="url(#dth)" opacity=".6"/>
<ellipse cx="520" cy="394" rx="62" ry="12" fill="#000" stroke="#fff" stroke-width="2"/><ellipse cx="90" cy="400" rx="40" ry="8" fill="#000" stroke="#aaa"/><ellipse cx="690" cy="388" rx="34" ry="7" fill="#000" stroke="#aaa"/>
<path d="M300 385l10-8 12 6-6 7z M440 380l8-6 9 5-5 6z M610 402l7-5 8 4-4 6z" fill="#555" stroke="#fff"/>
<!-- guide line -->
<line id="guide" x1="170" y1="296" x2="170" y2="296" stroke="#777" stroke-width="2" stroke-dasharray="4 8" opacity=".6"/>
<line id="beam" x1="170" y1="296" x2="170" y2="296" stroke="#fff" stroke-width="5" opacity="0"/>
<circle id="dot" r="7" fill="#35e0ff" opacity="0"/>
<!-- reflector on tripod -->
<g id="refl" transform="translate(170 296)">
 <path d="M0 22L-34 82M0 22L0 86M0 22L34 82" stroke="#fff" stroke-width="3" fill="none" transform="translate(0 0)"/>
</g>
<g id="panel" transform="translate(170 296) rotate(0)">
 <rect x="-40" y="-30" width="80" height="60" fill="#111" stroke="#fff" stroke-width="3"/>
 <g id="cubes"></g>
 <rect x="-8" y="30" width="16" height="10" fill="#fff"/>
</g>
<text x="170" y="408" text-anchor="middle" font-size="8" fill="#fff">REFLECTOR</text>
<!-- crosshair -->
<g id="sight" transform="translate(300 250)" fill="none" stroke="#fff" stroke-width="3">
 <circle r="18"/><path d="M-30 0H-8M8 0H30M0 -30V-8M0 8V30"/><rect x="-2" y="-2" width="4" height="4" fill="#fff" stroke="none"/>
</g>
<g id="fx"></g>
</svg></div>
<div class="hud">
 <div class="al"><span>ALIGNMENT</span><div class="bar" id="bar"><i id="barI"></i><b></b></div><span class="n" id="pct">0%</span></div>
 <div class="pips"><span>PULSES</span><span id="pips"><u></u><u></u><u></u></span></div>
</div>
<div class="ctl">
 <div class="pad big"><i></i><button class="b" data-k="up" aria-label="Up">▲</button><i></i><button class="b" data-k="left" aria-label="Left">◀</button><button class="b" data-k="down" aria-label="Down">▼</button><button class="b" data-k="right" aria-label="Right">▶</button></div>
 <div class="acts" style="flex-direction:column;align-items:flex-start"><div class="msg" id="msg" style="text-align:left;min-height:34px">Move the white sight into the cyan ring.</div><div class="row"><button class="b cy send" id="send" disabled>SEND LASER PULSE</button><button class="b" id="skip">SKIP</button></div></div>
</div>
</main>
<section class="ov" id="intro"><div class="card">
 <div class="eyebrow">HOW TO PLAY</div>
 <h2>ALIGN THE LUNAR REFLECTOR</h2>
 <p>Move the white sight into the cyan ring around Earth. Reach 85% alignment, then send a laser pulse.</p>
 <div class="how"><div><b>01</b>MOVE THE <span style="color:#fff">WHITE SIGHT</span> WITH THE ARROWS</div><div><b>02</b>PUT IT INSIDE THE <span class="cyt">CYAN RING</span> AROUND EARTH</div><div><b>03</b>AT 85% SEND THE <span class="cyt">LASER PULSE</span>. YOU HAVE 3</div></div>
 <button class="b cy" id="start">START ALIGNMENT →</button>
</div></section>
<section class="ov" id="end" hidden><div class="card">
 <div class="eyebrow" id="eTag"></div><h2 id="eTitle"></h2><p id="eText"></p>
 <div class="row"><button class="b" id="again">TRY AGAIN</button></div>
</div></section>
@@JS@@
(function(){
 var NS='http://www.w3.org/2000/svg', $=function(s){return document.querySelector(s);};
 var R={x:170,y:296}, E0={x:590,y:112}, D=520, TH=.85;
 var keys={}, S={x:300,y:250}, vel={x:0,y:0}, tremor={x:0,y:0,tx:0,ty:0,tt:0}, earth={x:E0.x,y:E0.y}, t=0, last=0, running=false, over=false, pulses=3, firstTry=true, flight=null, lastM='', ang=0, align=0, missUntil=0;
 window.MG3.holdButtons(keys);
 var cg=$('#cubes'); for(var r=0;r<4;r++) for(var c=0;c<5;c++){ var ci=document.createElementNS(NS,'circle'); ci.setAttribute('cx',-28+c*14); ci.setAttribute('cy',-20+r*13); ci.setAttribute('r',4.2); ci.setAttribute('fill','#000'); ci.setAttribute('stroke','#fff'); ci.setAttribute('stroke-width','1.5'); cg.appendChild(ci); }
 function msg(s,c){ var key=s+'|'+(c||''); if(key===lastM) return; lastM=key; var m=$('#msg'); m.textContent=s; m.className='msg'+(c?' '+c:''); }
 function setPips(){ var u=document.querySelectorAll('#pips u'); for(var i=0;i<3;i++) u[i].className=(i<pulses?'':'x'); }
 function reset(){ S={x:300,y:250}; vel={x:0,y:0}; pulses=3; firstTry=true; flight=null; over=false; setPips(); $('#beam').setAttribute('opacity',0); $('#dot').setAttribute('opacity',0); $('#fx').innerHTML=''; lastM=''; msg('Move the white sight into the cyan ring.'); }
 function alignAt(p){ var d=Math.hypot(p.x-earth.x,p.y-earth.y); return Math.max(0,Math.min(1,1-d/D)); }
 function end(win,perfect){
  running=false; over=true;
  if(win){ $('#eTag').textContent=perfect?'SIGNAL CONFIRMED · PERFECT':'SIGNAL CONFIRMED'; $('#eTitle').innerHTML='REFLECTOR<br>ALIGNED'; $('#eText').textContent='EARTH SIGNAL RECEIVED — REFLECTOR ALIGNED'; }
  else { $('#eTag').textContent='NO SIGNAL'; $('#eTitle').innerHTML='SIGNAL<br>MISSED'; $('#eText').textContent='SIGNAL MISSED — REALIGN THE REFLECTOR.'; }
  window.MG3.report(win,perfect,false); $('#end').hidden=false; $('#again').focus();
 }
 function fire(){
  if(!running||flight||over||align<TH) return;
  flight={t:0,aim:{x:S.x,y:S.y},hit:null,evaluated:false};
  msg('PULSE SENT — HOLD STEADY','good'); $('#send').disabled=true;
 }
 function stepFlight(dt){
  var f=flight; f.t+=dt; var T=.75, beam=$('#beam'), dot=$('#dot');
  var tgt={x:earth.x,y:earth.y};
  if(f.t<T){ var k=f.t/T, px=R.x+(f.aim.x-R.x)*k, py=R.y+(f.aim.y-R.y)*k; beam.setAttribute('x2',px); beam.setAttribute('y2',py); beam.setAttribute('opacity',1); dot.setAttribute('cx',px); dot.setAttribute('cy',py); dot.setAttribute('opacity',1); }
  else {
   if(!f.evaluated){ f.evaluated=true; f.hit=alignAt(f.aim)>=TH; }
   if(f.hit){
    var k2=Math.min(1,(f.t-T)/T), tx=earth.x, ty=earth.y;
    var px2=tx+(R.x-tx)*k2, py2=ty+(R.y-ty)*k2; beam.setAttribute('x1',tx); beam.setAttribute('y1',ty); beam.setAttribute('x2',px2); beam.setAttribute('y2',py2); beam.setAttribute('opacity',1);
    dot.setAttribute('cx',px2); dot.setAttribute('cy',py2); $('#ringE').classList.add('hit');
    if(k2>=1){ flight=null; beam.setAttribute('x1',R.x); beam.setAttribute('y1',R.y); beam.setAttribute('opacity',0); dot.setAttribute('opacity',0); msg('EARTH SIGNAL RECEIVED','good'); end(true,firstTry); }
   } else {
    if(f.t>T+.5){ flight=null; beam.setAttribute('opacity',0); dot.setAttribute('opacity',0); pulses--; firstTry=false; setPips(); if(pulses<=0){ end(false,false); } else { missUntil=t+2.4; msg('PULSE MISSED — '+pulses+' LEFT. CENTER THE SIGHT IN THE RING.','err'); } }
   }
  }
 }
 function frame(now){
  if(!last) last=now; var dt=Math.min(.05,(now-last)/1000); last=now; t+=dt;
  earth.x=E0.x+Math.sin(t*.55)*34; earth.y=E0.y+Math.sin(t*.8+1)*16;
  $('#earth').setAttribute('transform','translate('+earth.x+' '+earth.y+')');
  if(running){
   var ax=(keys.right?1:0)-(keys.left?1:0), ay=(keys.down?1:0)-(keys.up?1:0), n=Math.hypot(ax,ay)||1, sp=170;
   var tx=(ax||ay)?ax/n*sp:0, ty=(ax||ay)?ay/n*sp:0, k=Math.min(1,dt*9);
   vel.x+=(tx-vel.x)*k; vel.y+=(ty-vel.y)*k;
   tremor.tt-=dt; if(tremor.tt<=0){ tremor.tt=.5; tremor.tx=(Math.random()-.5)*10; tremor.ty=(Math.random()-.5)*10; }
   tremor.x+=(tremor.tx-tremor.x)*dt*3; tremor.y+=(tremor.ty-tremor.y)*dt*3;
   S.x+=vel.x*dt; S.y+=vel.y*dt; S.x=Math.max(24,Math.min(776,S.x)); S.y=Math.max(24,Math.min(350,S.y));
   align=alignAt({x:S.x+tremor.x,y:S.y+tremor.y});
   var pct=Math.round(align*100); $('#pct').textContent=pct+'%'; $('#barI').style.width=pct+'%'; $('#bar').classList.toggle('ok',align>=TH);
   $('#ringE').classList.toggle('hit',align>=TH);
   if(!flight){
    $('#send').disabled=align<TH;
    if(t<missUntil){}
    else if(align>=TH) msg('ALIGNED — SEND THE LASER PULSE.','good'); else msg('ALIGNMENT '+pct+'% — NEED 85% TO SEND A PULSE.');
   }
   if(flight) stepFlight(dt);
  }
  var sx=S.x+(running?tremor.x:0), sy=S.y+(running?tremor.y:0);
  $('#sight').setAttribute('transform','translate('+sx+' '+sy+')');
  var a=Math.atan2(sx-R.x,-(sy-R.y))*180/Math.PI; a=Math.max(-75,Math.min(75,a)); ang+=(a-ang)*Math.min(1,dt*6);
  $('#panel').setAttribute('transform','translate('+R.x+' '+R.y+') rotate('+ang+')');
  if(!flight){ var g=$('#guide'); g.setAttribute('x2',sx); g.setAttribute('y2',sy); g.setAttribute('opacity',.6); $('#beam').setAttribute('x1',R.x); $('#beam').setAttribute('y1',R.y); }
  else $('#guide').setAttribute('opacity',.15);
  requestAnimationFrame(frame);
 }
 $('#send').onclick=fire;
 function skip(){ if(over) return; running=false; over=true; flight=null; $('#eTag').textContent='MINI-GAME SKIPPED'; $('#eTitle').innerHTML='CONTINUE<br>MISSION'; $('#eText').textContent='The mission continues without a bonus.'; $('#end').hidden=false; $('#again').focus(); window.MG3.report(false,false,true); }
 $('#skip').onclick=skip;
 window.addEventListener('keydown',function(e){ if(e.key==='Escape'){ e.preventDefault(); skip(); return; } if((e.key===' '||e.key==='Enter')&&running&&!e.target.closest('button')){ e.preventDefault(); fire(); } });
 $('#start').onclick=function(){ $('#intro').hidden=true; running=true; window.MG3.start(); };
 $('#again').onclick=function(){ $('#end').hidden=true; reset(); $('#ringE').classList.remove('hit'); running=true; window.MG3.start(); };
 reset(); requestAnimationFrame(frame);
})();
